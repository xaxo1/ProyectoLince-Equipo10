# Copia este archivo como "secretos.properties" (en esta misma carpeta) y completa los valores.
# secretos.properties está en .gitignore: NUNCA se sube a GitHub.

# Clave del curso para la Lince API (ver anexo técnico del encargo EA4)
lince.api.key=PEGA_AQUI_LA_X_API_KEY

# Secreto para firmar los JWT: cualquier texto largo y aleatorio (mínimo 32 caracteres)
lince.jwt.secreto=CAMBIA_ESTE_TEXTO_POR_UNO_LARGO_Y_ALEATORIO_DE_32_O_MAS
